@echo off
rem ==============================================================================
rem Local configuration for connect-qdc-sdp.bat
rem
rem Copy this file to "config.local.bat" (in the same directory) and fill in your
rem values. config.local.bat is git-ignored so your secrets stay local.
rem ==============================================================================

rem REQUIRED: Path to your SSH private key
set "SSH_KEY=%HOME%\.ssh\id_ed25519"


rem REQUIRED: Your QDC API key (from https://qdc.qualcomm.com)
set "QDC_API_KEY=your-api-key-here"

rem OPTIONAL: Override the QDC sessions API URL (defaults are usually fine)
rem set "QDC_SESSIONS_URL=https://api.qualcomm.com/deviceloud/v1/sessions"

rem OPTIONAL (Mobile/Android targets): Full path to the adb executable.
rem Set this only if adb is NOT on your PATH. Point it at adb.exe itself
rem (not its folder). When unset, the launcher uses "adb" from PATH.
rem set "ADB_PATH=C:\platform-tools\adb.exe"


rem ==============================================================================
rem IOT-SPECIFIC settings (only used when QDC_CHIPSET_CATEGORY=IOT)
rem ==============================================================================

rem Device root password. When set, device ssh/scp use password auth with no prompts
rem (via SSH_ASKPASS; Windows OpenSSH 8.6+). Leave unset to use SSH key auth instead.
rem set "IOT_TARGET_PASSWORD=Put_your_password_here"