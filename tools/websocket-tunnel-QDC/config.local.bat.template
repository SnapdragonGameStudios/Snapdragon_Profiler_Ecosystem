@echo off
rem ==============================================================================
rem Local configuration for connect-qdc-sdp.bat
rem
rem Copy this file to "config.local.bat" (in the same directory) and fill in your
rem values. config.local.bat is git-ignored so your secrets stay local.
rem ==============================================================================

rem REQUIRED: Path to your SSH private key
set "SSH_KEY=%HOME%\.ssh\id_ed25519"


rem REQUIRED: Your QDC API key (from https://qdc.qualcomm.com)
set "QDC_API_KEY=your-api-key-here"

rem OPTIONAL: Override the QDC sessions API URL (defaults are usually fine)
rem set "QDC_SESSIONS_URL=https://api.qualcomm.com/deviceloud/v1/sessions"